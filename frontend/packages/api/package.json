{
  "name": "@lgs/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/generated/schema.d.ts"
  },
  "scripts": {
    "gen:api": "openapi-typescript ../../../contracts/openapi.json -o src/generated/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "vitest": "5.1.0"
  }
}
