{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=LGSApp;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Issuer": "LGSApp",
    "Audience": "LGSApp.Clients",
    "Key": "DEV-ONLY-placeholder-key-change-via-user-secrets-or-env-0123456789",
    "ExpiryMinutes": 60,
    "MudurExpiryMinutes": 30,
    "Refresh": {
      "SlidingDays": 30,
      "FamilyMaxDays": 90,
      "MudurAbsoluteHours": 12,
      "ReuseGraceSeconds": 30,
      "CleanupRetentionDays": 7,
      "MaxGraceSiblings": 3,
      "CleanupEnabled": true,
      "CleanupIntervalMinutes": 360
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "RateLimiting": {
    "Login": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "ForgotPassword": {
      "PermitLimit": 5,
      "WindowSeconds": 300
    },
    "Recover": {
      "PermitLimit": 5,
      "WindowSeconds": 300
    },
    "Refresh": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    },
    "CommentWrite": {
      "PermitLimit": 6,
      "WindowSeconds": 60
    },
    "AnswerSubmit": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "ReportCreate": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "AssignmentWrite": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    },
    "FileUpload": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    },
    "QuestionCreate": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "SchedulerTrigger": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "AdminSettings": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Scheduler": {
    "Enabled": true,
    "GenerateAt": "17:30",
    "CompleteAt": "18:15",
    "PublishAt": "19:00",
    "AssignmentsAt": "00:05",
    "TopicSelectionDeadline": "16:45",
    "CatchUpGenerateUntil": "23:00",
    "CompleteMinGapMinutes": 15,
    "PublishWaitMaxMinutes": 30,
    "LeaseSeconds": 180,
    "HeartbeatSeconds": 45,
    "MaxRunMinutes": 45,
    "DelayBetweenAiCallsSeconds": 6,
    "MaxTimerAttemptsPerDay": 3,
    "RetryDelayMinutes": 10,
    "MaxSlotsPerLesson": 20,
    "StartupDelaySeconds": 15,
    "UseFakeGenerator": false,
    "FakeGenerator": {
      "FailSlots": "",
      "DelayMs": 0
    }
  },
  "Ai": {
    "Provider": "Gemini",
    "Required": false,
    "Gemini": {
      "BaseUrl": "https://generativelanguage.googleapis.com",
      "ApiVersion": "v1beta",
      "QuestionApiKey": "",
      "SolutionApiKey": ""
    },
    "Question": {
      "Model": "gemini-3.8-flash",
      "ThinkingLevel": "low",
      "MaxOutputTokens": 4096,
      "TimeoutSeconds": 90,
      "MaxAttempts": 3,
      "SlotBudgetSeconds": 240,
      "Max429WaitSeconds": 40,
      "VerifyEnabled": true
    },
    "Solution": {
      "Model": "gemini-3.8-flash",
      "ThinkingLevel": "medium",
      "MaxOutputTokens": 8192,
      "TimeoutSeconds": 60,
      "MaxAttempts": 2,
      "Max429WaitSeconds": 5,
      "ImageMaxEdge": 1536,
      "ImageJpegQuality": 80
    },
    "Pricing": {
      "gemini-3.8-flash": {
        "InputPerMTokUsd": 0.75,
        "OutputPerMTokUsd": 3.75
      }
    },
    "Fake": {
      "FailSlots": "",
      "DelayMs": 0,
      "MismatchEveryNth": 0,
      "UnreadableQuestionIds": ""
    }
  },
  "Storage": {
    "ConnectionString": "",
    "Container": "images",
    "PublicEndpoint": null,
    "ReadSasMinutes": 90,
    "ReadSasBucketMinutes": 30,
    "CreateContainerIfMissing": false
  },
  "Uploads": {
    "MaxBytes": 10485760,
    "MaxPixels": 50000000,
    "MinEdge": 200,
    "MaxEdge": 2000,
    "JpegQuality": 82,
    "MaxConcurrentProcessing": 2,
    "PendingTimeoutMinutes": 30,
    "UnusedRetentionDays": 7,
    "CleanupIntervalMinutes": 360,
    "CleanupBatchSize": 100,
    "CleanupEnabled": true
  },
  "ResponseTiming": {
    "LoginFailureMinMilliseconds": 400,
    "ForgotPasswordMinMilliseconds": 300,
    "RecoverMinMilliseconds": 700
  },
  "ForwardedHeaders": {
    "Enabled": false,
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1
  },
  "Bff": {
    "ProxyKey": ""
  },
  "Seed": {
    "Enabled": false,
    "AdminUserName": "",
    "AdminPassword": ""
  }
}
