{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=LGSApp;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Issuer": "LGSApp",
    "Audience": "LGSApp.Clients",
    "Key": "DEV-ONLY-placeholder-key-change-via-user-secrets-or-env-0123456789",
    "ExpiryMinutes": 60,
    "MudurExpiryMinutes": 30
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "RateLimiting": {
    "Login": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "ForgotPassword": {
      "PermitLimit": 5,
      "WindowSeconds": 300
    },
    "Recover": {
      "PermitLimit": 5,
      "WindowSeconds": 300
    },
    "CommentWrite": {
      "PermitLimit": 6,
      "WindowSeconds": 60
    },
    "AnswerSubmit": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "ReportCreate": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "AssignmentWrite": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    },
    "FileUpload": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    },
    "QuestionCreate": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Storage": {
    "ConnectionString": "",
    "Container": "images",
    "PublicEndpoint": null,
    "ReadSasMinutes": 90,
    "ReadSasBucketMinutes": 30,
    "CreateContainerIfMissing": false
  },
  "Uploads": {
    "MaxBytes": 10485760,
    "MaxPixels": 50000000,
    "MinEdge": 200,
    "MaxEdge": 2000,
    "JpegQuality": 82,
    "MaxConcurrentProcessing": 2,
    "PendingTimeoutMinutes": 30,
    "UnusedRetentionDays": 7,
    "CleanupIntervalMinutes": 30,
    "CleanupBatchSize": 100,
    "CleanupEnabled": true
  },
  "ResponseTiming": {
    "LoginFailureMinMilliseconds": 400,
    "ForgotPasswordMinMilliseconds": 300,
    "RecoverMinMilliseconds": 700
  },
  "ForwardedHeaders": {
    "Enabled": false,
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1
  },
  "Seed": {
    "Enabled": false,
    "AdminUserName": "",
    "AdminPassword": ""
  }
}
